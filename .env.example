# Environment variables template (versioned).
# Copy it to .env (git-ignored) and adjust the values:
#
#   cp .env.example .env      # bin/setup does this for you
#
# The same .env serves both ways of running the app:
#   - Docker Compose (docker compose up): compose.yaml reads these values and
#     points the app at its own db and redis containers (DATABASE_HOST and
#     REDIS_URL below are ignored there). Without a .env, compose.yaml falls
#     back to postgres/postgres and the Sidekiq dashboard stays locked.
#   - Natively (bin/dev): the app reads this file through dotenv.
#
# Never put real credentials in this file.

# --- Database (read by config/database.yml) ---------------------------------
# With Docker Compose, the db container is created with this user and password.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
# Production: set DATABASE_URL instead of the variables above.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/movie_on_rails_production

# --- Redis (Sidekiq, Action Cable, cache) -----------------------------------
REDIS_URL=redis://localhost:6379/0
SIDEKIQ_CONCURRENCY=5

# --- Sidekiq web UI (/sidekiq, HTTP Basic Auth; denied when blank) ----------
SIDEKIQ_USERNAME=admin
SIDEKIQ_PASSWORD=change_me

# --- Puma / connection pool --------------------------------------------------
RAILS_MAX_THREADS=5

# --- Docker Compose only -----------------------------------------------------
# Ports on your machine. Inside Docker the containers talk to each other by
# service name (db:5432, redis:6379); these only matter to reach them from
# outside, e.g. psql -h localhost -p 5433 -U postgres
WEB_PORT=3000
DOCKER_DATABASE_PORT=5433
DOCKER_REDIS_PORT=6380
# Your user and group ids (run `id -u` and `id -g`), so files the containers
# write into the project belong to you. 1000 is the default on most Linux/WSL.
UID=1000
GID=1000
