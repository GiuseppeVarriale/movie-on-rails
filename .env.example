# Environment variables template (versioned).
# Copy it to .env (git-ignored) and adjust the values:
#
#   cp .env.example .env      # bin/setup does this for you
#
# Never put real credentials in this file.

# --- Database (read by config/database.yml) ---------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me
# Production: set DATABASE_URL instead of the variables above.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/movie_on_rails_production

# --- Redis (Sidekiq, Action Cable, cache) -----------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Puma / connection pool --------------------------------------------------
RAILS_MAX_THREADS=5
