<article id="<%= dom_id(movie) %>" class="flex flex-col rounded-2xl border border-ink-20 bg-white p-6 transition hover:border-brand-30 hover:shadow-md">
  <header>
    <p class="eyebrow"><%= movie.year %></p>
    <h2 class="mt-2 text-h5 font-semibold">
      <%= link_to movie.title, movie_path(movie), data: { turbo_frame: "_top" }, class: "hover:text-brand-60 hover:underline" %>
    </h2>
    <p class="mt-1 text-sm text-ink-60"><%= t(".directed_by", director: movie.director) %></p>
  </header>

  <div class="mt-4 flex items-center gap-3">
    <%= render "movies/rating", movie: %>
  </div>

  <% actors, hidden_actors = card_actors(movie, first: local_assigns[:highlighted_actor]) %>
  <div class="mt-5">
    <h3 class="sr-only"><%= t(".cast") %></h3>
    <ul class="flex flex-wrap gap-2" aria-label="<%= t(".cast") %>">
      <% actors.each do |actor| %>
        <li>
          <%= link_to actor.name, movies_path(actor_id: actor.id),
                data: { turbo_frame: "_top" }, title: t(".filter_by", actor: actor.name),
                aria: { current: (actor == local_assigns[:highlighted_actor] ? "true" : nil) },
                class: ["block rounded-full px-3 py-1 text-xs font-medium transition",
                        actor == local_assigns[:highlighted_actor] ? "bg-brand-90 text-white" : "bg-brand-5 text-brand-80 hover:bg-brand-10"] %>
        </li>
      <% end %>
      <% if hidden_actors.positive? %>
        <li class="rounded-full bg-ink-10 px-3 py-1 text-xs font-medium text-ink-60"><%= t(".more", count: hidden_actors) %></li>
      <% end %>
    </ul>
  </div>

  <% locations, hidden_locations = card_locations(movie) %>
  <p class="mt-auto pt-5 text-sm text-ink-60">
    <span class="font-semibold text-brand-90"><%= t(".filmed_in") %></span>
    <%= locations.map { |location| filming_location_label(location) }.join(t(".separator")) %>
    <% if hidden_locations.positive? %>
      <span class="ml-1 whitespace-nowrap rounded-full bg-ink-10 px-2 py-0.5 text-xs font-medium"><%= t(".more", count: hidden_locations) %></span>
    <% end %>
  </p>
</article>
