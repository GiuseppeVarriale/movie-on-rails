<% content_for :title, t(".title") %>

<section aria-labelledby="movies-title">
  <p class="eyebrow"><%= t(".eyebrow") %></p>
  <h1 id="movies-title" class="mt-3 text-h2 sm:text-h1"><%= t(".title") %></h1>

  <%= render "movies/filters", search: @search %>

  <%= turbo_frame_tag "movies", data: { turbo_action: "advance" }, class: "mt-10 block" do %>
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-ink-60" aria-live="polite">
        <% if @search.selected_actor %>
          <%= t(".results.actor", count: @pagy.count, actor: @search.selected_actor.name) %>
        <% elsif @search.actor %>
          <%= t(".results.matching", count: @pagy.count, text: @search.actor) %>
        <% else %>
          <%= t(".results.all", count: @pagy.count) %>
        <% end %>
      </p>

      <nav aria-label="<%= t(".sort.label") %>" class="flex flex-wrap gap-2">
        <% MovieSearch::SORTS.each_key do |sort| %>
          <%= link_to t(".sort.#{sort}"), movies_path(@search.params.merge(sort:)),
                aria: { current: (@search.sort == sort ? "true" : nil) },
                class: ["rounded-full border px-4 py-2 text-sm font-medium transition",
                        @search.sort == sort ? "border-brand-90 bg-brand-90 text-white" : "border-ink-30 text-brand-90 hover:border-brand-60 hover:bg-brand-5"] %>
        <% end %>
      </nav>
    </div>

    <% if @movies.any? %>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <%= render partial: "movies/movie", collection: @movies, locals: { highlighted_actor: @search.selected_actor } %>
      </div>

      <% if @pagy.last > 1 %>
        <div class="mt-10 flex justify-center">
          <%== @pagy.series_nav(aria_label: t(".pages")) %>
        </div>
      <% end %>
    <% elsif @search.filtered_by_actor? %>
      <div class="mt-6 rounded-2xl bg-ink-5 px-6 py-12 text-center">
        <p class="text-h5"><%= t(".empty_filter.title") %></p>
        <p class="mt-2 text-ink-60"><%= link_to t(".empty_filter.clear"), movies_path(@search.params.except(:actor_id, :actor)), data: { turbo_frame: "_top" }, class: "font-medium text-brand-60 underline" %></p>
      </div>
    <% else %>
      <div class="mt-6 rounded-2xl bg-ink-5 px-6 py-12 text-center">
        <p class="text-h5"><%= t(".empty.title") %></p>
        <p class="mt-2 text-ink-60"><%= t(".empty.hint_html", command: tag.code(t(".empty.command"), class: "rounded-xs bg-white px-2 py-1 text-sm text-brand-80")) %></p>
      </div>
    <% end %>
  <% end %>
</section>
