<% content_for :title, t(".title") %>

<section aria-labelledby="movies-title">
  <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="eyebrow"><%= t(".eyebrow") %></p>
      <h1 id="movies-title" class="mt-3 text-h2 sm:text-h1"><%= t(".title") %></h1>
    </div>

    <nav aria-label="<%= t(".sort.label") %>" class="flex flex-wrap gap-2">
      <% MovieSearch::SORTS.each_key do |sort| %>
        <%= link_to t(".sort.#{sort}"), movies_path(sort:),
              aria: { current: (@search.sort == sort ? "true" : nil) },
              class: ["rounded-full border px-4 py-2 text-sm font-medium transition",
                      @search.sort == sort ? "border-brand-90 bg-brand-90 text-white" : "border-ink-30 text-brand-90 hover:border-brand-60 hover:bg-brand-5"] %>
      <% end %>
    </nav>
  </div>

  <% if @movies.any? %>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <%= render @movies %>
    </div>

    <% if @pagy.last > 1 %>
      <div class="mt-10 flex justify-center">
        <%== @pagy.series_nav(aria_label: t(".pages")) %>
      </div>
    <% end %>
  <% else %>
    <div class="mt-10 rounded-2xl bg-ink-5 px-6 py-12 text-center">
      <p class="text-h5"><%= t(".empty.title") %></p>
      <p class="mt-2 text-ink-60"><%= t(".empty.hint_html", command: tag.code(t(".empty.command"), class: "rounded-xs bg-white px-2 py-1 text-sm text-brand-80")) %></p>
    </div>
  <% end %>
</section>
