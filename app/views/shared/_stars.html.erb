<% percentage = average ? (average.to_d / Review::MAX_STARS * 100).round(1) : 0 %>
<% precision = local_assigns.fetch(:precision, 2) %>
<span class="relative inline-block <%= local_assigns.fetch(:size, "text-lg") %> leading-none tracking-wider" role="img"
      aria-label="<%= average ? t("shared.stars.rated", average: number_with_precision(average, precision:), max: Review::MAX_STARS) : t("shared.stars.unrated") %>">
  <span class="text-ink-30" aria-hidden="true"><%= "★" * Review::MAX_STARS %></span>
  <span class="absolute inset-0 overflow-hidden whitespace-nowrap text-star" style="width: <%= percentage %>%" aria-hidden="true"><%= "★" * Review::MAX_STARS %></span>
</span>
