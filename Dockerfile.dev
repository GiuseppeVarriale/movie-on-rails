# syntax=docker/dockerfile:1
# Development image used by compose.yaml (the generated Dockerfile is for production).
# The code is bind-mounted at /rails, so changes show up without rebuilding.

ARG RUBY_VERSION=4.0.9
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

# Build tools for native gems, the Postgres client and jemalloc
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl git libjemalloc2 libpq-dev libyaml-dev pkg-config postgresql-client && \
    ln -s /usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2 /usr/local/lib/libjemalloc.so && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# jemalloc keeps the memory of long-lived Ruby processes (Puma, Sidekiq) stable after big imports
ENV RAILS_ENV="development" \
    BUNDLE_PATH="/usr/local/bundle" \
    LD_PRELOAD="/usr/local/lib/libjemalloc.so"

# Run as a regular user with the host's ids, so files written to the bind mount
# (log/, tmp/, app/assets/builds/) belong to you, not to root
ARG UID=1000
ARG GID=1000
RUN groupadd --system --gid $GID rails && \
    useradd rails --uid $UID --gid $GID --create-home --shell /bin/bash && \
    mkdir -p $BUNDLE_PATH && chown rails:rails $BUNDLE_PATH /rails
USER rails

# Install the gems at build time; the entrypoint installs new ones after a Gemfile change
COPY --chown=rails:rails Gemfile Gemfile.lock .ruby-version ./
RUN bundle install --jobs 4

ENTRYPOINT ["bin/docker-dev-entrypoint"]
EXPOSE 3000
CMD ["bin/rails", "server", "-b", "0.0.0.0"]
